{
  "name": "streamx",
  "version": "2.26.0",
  "description": "An iteration of the Node.js core streams with a series of improvements",
  "main": "index.js",
  "exports": {
    ".": {
      "types": {
        "bare": "./index.bare.d.ts",
        "default": "./index.node.d.ts"
      },
      "default": "./index.js"
    },
    "./package": "./package.json",
    "./errors": {
      "types": "./lib/errors.d.ts",
      "default": "./lib/errors"
    }
  },
  "dependencies": {
    "events-universal": "^1.0.0",
    "fast-fifo": "^1.3.2",
    "text-decoder": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "b4a": "^1.6.6",
    "bare-abort-controller": "^1.1.2",
    "bare-buffer": "^3.6.1",
    "bare-events": "^2.9.1",
    "brittle": "^3.1.1",
    "end-of-stream": "^1.4.4",
    "lunte": "^1.8.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "peerDependencies": {
    "@types/node": "*",
    "bare-abort-controller": "*",
    "bare-buffer": "*",
    "bare-events": "*"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "bare-abort-controller": {
      "optional": true
    },
    "bare-buffer": {
      "optional": true
    },
    "bare-events": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "index.bare.d.ts",
    "index.node.d.ts",
    "lib"
  ],
  "scripts": {
    "format": "prettier --write .",
    "test": "lunte && prettier --check . && node test/all.js",
    "test:bare": "bare test/all.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mafintosh/streamx.git"
  },
  "author": "Mathias Buus (@mafintosh)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mafintosh/streamx/issues"
  },
  "homepage": "https://github.com/mafintosh/streamx"
}
